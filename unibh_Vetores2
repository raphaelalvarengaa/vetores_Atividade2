    private static void Exercicio13() {
        Scanner scanner = new Scanner(System.in);
        System.out.print("Digite o valor de N: ");
        int n = scanner.nextInt();

        System.out.println("Números primos até " + n + ":");

        for (int i = 2; i <= n; i++) {
            boolean ehPrimo = true;

            // Testa se o número 'i' é divisível por algum número menor que ele
            for (int j = 2; j <= Math.sqrt(i); j++) {
                if (i % j == 0) {
                    ehPrimo = false;
                    break;
                }
            }

            if (ehPrimo) {
                System.out.print(i + " ");
            }
        }
        System.out.println(); // Pula uma linha no final
    }

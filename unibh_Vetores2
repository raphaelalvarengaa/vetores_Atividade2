    private static void Exercicio6() {
        Random random = new Random();
        Scanner scanner = new Scanner(System.in);
        int[] vetor = new int[30];

        System.out.print("Vetor gerado: ");
        for (int i = 0; i < vetor.length; i++) {
            vetor[i] = random.nextInt(100) + 1;
            System.out.print(vetor[i] + " ");
        }
        System.out.print("Digite um número para remover: ");
        int valorRemover = scanner.nextInt();

        // Contar quantos elementos restantes teremos
        int ocorrencias = 0;
        for (int num : vetor) {
            if (num == valorRemover) ocorrencias++;
        }
        if (ocorrencias == 0) {
            System.out.println("Valor não encontrado no vetor.");
        } else {
            int[] novoVetor = new int[vetor.length - ocorrencias];
            int j = 0;
            for (int num : vetor) {
                if (num != valorRemover) {
                    novoVetor[j++] = num;
                }
            }

            System.out.print("Vetor após a remoção: ");
            for (int num : novoVetor) {
                System.out.print(num + " ");
            }
        }
    }
